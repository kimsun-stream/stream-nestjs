generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                    Int       @id @default(autoincrement())
  email                                 String    @unique @db.VarChar(255)
  username                              String    @unique @db.VarChar(50)
  password                              String    @db.VarChar(255)
  profile_image_url                     String?   @db.VarChar(500)
  is_email_verified                     Boolean?  @default(false)
  email_verify_token                    String?   @db.VarChar(255)
  created_at                            DateTime  @default(now()) @db.Timestamptz(6)
  chats                                 Chat[]
  follows_follows_follower_idTousers    follows[] @relation("follows_follower_idTousers")
  follows_follows_following_idTousers   follows[] @relation("follows_following_idTousers")
  rooms                                 rooms[]

  @@map("users")
}

model Chat {
  id        Int      @id @default(autoincrement())
  message   String
  room_id   Int
  user_id   Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  rooms     rooms    @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_chats_created_at")
  @@index([room_id], map: "idx_chats_room_id")
  @@map("chats")
}

model follows {
  id                                Int      @id @default(autoincrement())
  follower_id                       Int
  following_id                      Int
  created_at                        DateTime @default(now()) @db.Timestamptz(6)
  users_follows_follower_idTousers  User     @relation("follows_follower_idTousers", fields: [follower_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_follows_following_idTousers User     @relation("follows_following_idTousers", fields: [following_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([follower_id, following_id])
  @@index([follower_id], map: "idx_follows_follower_id")
  @@index([following_id], map: "idx_follows_following_id")
}

model rooms {
  id            Int       @id @default(autoincrement())
  user_id       Int
  title         String    @db.VarChar(255)
  description   String?
  thumbnail_url String?   @db.VarChar(500)
  category      String?   @db.VarChar(100)
  started_at    DateTime? @db.Timestamptz(6)
  ended_at      DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  chats         Chat[]
  users         User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_rooms_user_id")
}
generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                      Int             @id @default(autoincrement())
  email                                   String          @unique @db.VarChar(255)
  username                                String          @unique @db.VarChar(50)
  password                                String          @db.VarChar(255)
  profile_image_url                       String?         @db.VarChar(500)
  bio                                     String?
  points                                  Int?            @default(0)
  is_email_verified                       Boolean?        @default(false)
  email_verify_token                      String?         @db.VarChar(255)
  created_at                              DateTime        @default(now()) @db.Timestamptz(6)
  chats                                   Chat[]
  contributions                           contributions[]
  donations_donations_from_user_idTousers donations[]     @relation("donations_from_user_idTousers")
  donations_donations_to_user_idTousers   donations[]     @relation("donations_to_user_idTousers")
  follows_follows_follower_idTousers      follows[]       @relation("follows_follower_idTousers")
  follows_follows_following_idTousers     follows[]       @relation("follows_following_idTousers")
  streams                                 streams[]

  @@map("users")
}

model Chat {
  id        Int      @id @default(autoincrement())
  message   String
  stream_id Int
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  streams   streams  @relation(fields: [stream_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_chats_created_at")
  @@index([stream_id], map: "idx_chats_stream_id")
  @@map("chats")
}

model contributions {
  id               Int      @id @default(autoincrement())
  user_id          Int
  stream_id        Int
  bytes_relayed    BigInt?  @default(0)
  duration_seconds Int?     @default(0)
  quality_score    Int?     @default(0)
  points_earned    Int?     @default(0)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  streams          streams  @relation(fields: [stream_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([stream_id], map: "idx_contributions_stream_id")
  @@index([user_id], map: "idx_contributions_user_id")
}

model donations {
  id                                  Int      @id @default(autoincrement())
  from_user_id                        Int
  to_user_id                          Int
  stream_id                           Int?
  amount                              Int
  message                             String?
  payment_key                         String?  @db.VarChar(255)
  status                              String   @default("pending") @db.VarChar(20)
  created_at                          DateTime @default(now()) @db.Timestamptz(6)
  users_donations_from_user_idTousers User     @relation("donations_from_user_idTousers", fields: [from_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  streams                             streams? @relation(fields: [stream_id], references: [id], onUpdate: NoAction)
  users_donations_to_user_idTousers   User     @relation("donations_to_user_idTousers", fields: [to_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_donations_created_at")
  @@index([to_user_id], map: "idx_donations_to_user_id")
}

model follows {
  id                                Int      @id @default(autoincrement())
  follower_id                       Int
  following_id                      Int
  created_at                        DateTime @default(now()) @db.Timestamptz(6)
  users_follows_follower_idTousers  User     @relation("follows_follower_idTousers", fields: [follower_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_follows_following_idTousers User     @relation("follows_following_idTousers", fields: [following_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([follower_id, following_id])
  @@index([follower_id], map: "idx_follows_follower_id")
  @@index([following_id], map: "idx_follows_following_id")
}

model stream_sessions {
  id               Int      @id @default(autoincrement())
  stream_id        Int
  recording_url    String?  @db.VarChar(500)
  duration_seconds Int?
  view_count       Int?     @default(0)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  streams          streams  @relation(fields: [stream_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model streams {
  id              Int               @id @default(autoincrement())
  user_id         Int
  title           String            @db.VarChar(255)
  description     String?
  thumbnail_url   String?           @db.VarChar(500)
  category        String?           @db.VarChar(100)
  status          String            @default("offline") @db.VarChar(20)
  viewer_count    Int?              @default(0)
  started_at      DateTime?         @db.Timestamptz(6)
  ended_at        DateTime?         @db.Timestamptz(6)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  chats           Chat[]
  contributions   contributions[]
  donations       donations[]
  stream_sessions stream_sessions[]
  users           User              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_streams_created_at")
  @@index([status], map: "idx_streams_status")
  @@index([user_id], map: "idx_streams_user_id")
}
